# ── Flask Core ──────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development  # Use 'production' in production deployments
SECRET_KEY=replace-with-a-cryptographically-secure-random-string-at-least-32-chars
SESSION_COOKIE_SECURE=false  # Set to 'true' when serving over HTTPS

# ── Database (PostgreSQL required in production) ───────────────
# Local SQLite example: sqlite:///mail_assistant.db
# Production PostgreSQL example: postgresql://user:password@localhost:5432/mailmind_db
DATABASE_URL=sqlite:///mail_assistant.db
SQLALCHEMY_DATABASE_URI=sqlite:///mail_assistant.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CREATE_DB_TABLES_ON_STARTUP=true  # Set to 'false' in production; use Alembic migrations

# ── Google OAuth 2.0 (Least Privilege: gmail.readonly only) ────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── Google Gemini AI ───────────────────────────────────────────
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT=30

# ── Cryptographic Encryption (Fernet Token Encryption) ─────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key

# ── Frontend Cross-Origin & Navigation ─────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Durable AI Worker Queue (Phase 6.1 / 6.2) ──────────────────
AI_JOB_POLL_INTERVAL=1.0
AI_JOB_STALE_SECONDS=300
AI_JOB_MAX_ATTEMPTS=3
AI_WORKER_ID=worker-prod-1
AI_JOB_ALWAYS_EAGER=false
