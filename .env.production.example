# =================================================================
# MailMind AI — Production Environment Variables Reference
# =================================================================
# Copy this file to .env before starting production services:
#   cp .env.production.example .env
#
# IMPORTANT: Never commit your real .env with secrets to Git!
# =================================================================

# ── General Server & Host Configuration ──────────────────────────
PORT=80
FRONTEND_URL=https://your-domain.com
FLASK_ENV=production
SESSION_COOKIE_SECURE=true

# ── Cryptographic Security Secrets ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_cryptographically_secure_random_key_here_at_least_32_chars

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_valid_32_byte_base64_fernet_key_here

# ── PostgreSQL Database ──────────────────────────────────────────
# If using Docker Compose (db service):
POSTGRES_USER=mailmind
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=mailmind_db

# If connecting to external hosted PostgreSQL (e.g. Neon, Supabase, RDS, Render):
DATABASE_URL=postgresql://mailmind:password@db-host:5432/mailmind_db?sslmode=require

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CREATE_DB_TABLES_ON_STARTUP=false

# ── Google Cloud Console OAuth 2.0 (gmail.readonly) ─────────────
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Add your production domain to Authorized JavaScript origins & Redirect URIs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ── Google Gemini AI ─────────────────────────────────────────────
# Obtain key from https://aistudio.google.com/
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT=30

# ── Durable AI Worker Queue Settings ─────────────────────────────
AI_JOB_POLL_INTERVAL=1.0
AI_JOB_STALE_SECONDS=300
AI_JOB_MAX_ATTEMPTS=3
AI_WORKER_ID=worker-prod-1
AI_JOB_ALWAYS_EAGER=false
